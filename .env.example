# Copia este archivo a .env.local para desarrollo local.
# En Vercel, configura estas variables en Project Settings > Environment Variables.

# Supabase (opcional en esta etapa: sin estas variables la app usa datos demo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chatbot Nova (Etapa 5). Solo se usa en la función serverless /api/nova.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
