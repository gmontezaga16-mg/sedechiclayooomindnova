# Copia este archivo a .env.local para desarrollo local (el archivo .env.local está en .gitignore).
# En Vercel, configura estas variables en Project Settings > Environment Variables.

# ---- Supabase (opcional) ----
# Sin estas dos variables, MINDNOVA funciona en modo demo con datos locales.
# Usa SOLO la clave pública: la clave "anon" o la "publishable" (sb_publishable_...).
# Nunca pongas aquí la clave service_role ni una sb_secret_...: todo lo que empieza por VITE_
# se incluye en el código que descarga el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Nova con IA (Groq). Solo se usa en la función serverless /api/nova. ----
# Esta clave NUNCA debe llevar prefijo VITE_: así no llega al navegador.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Pon 1 para que Nova redacte sus respuestas con Groq. Sin esta variable, Nova usa solo su motor local.
VITE_NOVA_IA=
